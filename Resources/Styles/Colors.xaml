                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="Danger">#E5484D</Color>

    <Color x:Key="PageLight">#F4F4F8</Color>
    <Color x:Key="PageDark">#121216</Color>

    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1F1F26</Color>

    <Color x:Key="SubtleLight">#ECECF2</Color>
