<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HabitTracker.ViewModels"
             x:Class="HabitTracker.Views.HabitDetailPage"
             x:DataType="vm:HabitDetailViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Изменить" Command="{Binding EditCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Заголовок -->
            <HorizontalStackLayout Spacing="12">
                <Label Text="{Binding Emoji}" FontSize="40" VerticalOptions="Center" />
                <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Статистика -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CurrentStreak}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{Binding AccentColor}" />
                        <Label Text="Серия" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding BestStreak}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{Binding AccentColor}" />
                        <Label Text="Рекорд" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding TotalDone}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{Binding AccentColor}" />
                        <Label Text="Всего дней" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Календарь -->
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="‹" FontSize="22" Padding="14,0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                Command="{Binding PreviousMonthCommand}" />
                        <Label Grid.Column="1" Text="{Binding MonthTitle}" FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="›" FontSize="22" Padding="14,0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                IsEnabled="{Binding CanGoNext}"
                                Command="{Binding NextMonthCommand}" />
                    </Grid>

                    <!-- Дни недели; ширина 14.2% совпадает с ячейками сетки ниже -->
                    <FlexLayout Wrap="Wrap">
                        <Label Text="Пн" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Вт" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Ср" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Чт" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Пт" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Сб" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="Вс" FlexLayout.Basis="14.2%" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                    </FlexLayout>

                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Days}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayCell">
                                <Grid FlexLayout.Basis="14.2%" HeightRequest="48" Padding="3">
                                    <Border IsVisible="{Binding IsInMonth}"
                                            StrokeThickness="2"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding ToggleDayCommand, Source={RelativeSource AncestorType={x:Type vm:HabitDetailViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Stroke" Value="{Binding AccentColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{Binding AccentColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsFuture}" Value="True">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{Binding Text}" FontSize="15"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="{Binding MonthSummary}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Удалить привычку" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
