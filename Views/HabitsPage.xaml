<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HabitTracker.ViewModels"
             x:Class="HabitTracker.Views.HabitsPage"
             x:DataType="vm:HabitsViewModel"
             Title="Привычки">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Добавить" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,8" Spacing="6">
            <Label Text="{Binding TodayText}" FontSize="26" FontAttributes="Bold" />
            <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" FontSize="15" />
            <ProgressBar Progress="{Binding Progress}"
                         ProgressColor="{StaticResource Primary}"
                         Margin="0,4,0,0" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Habits}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32">
                    <Label Text="🌱" FontSize="56" HorizontalOptions="Center" />
                    <Label Text="Пока нет привычек" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Нажмите «＋ Добавить» сверху, чтобы создать первую."
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HabitItem">
                    <Border Style="{StaticResource CardBorder}" Margin="20,6" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    WidthRequest="48" HeightRequest="48"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding AccentColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Emoji}" FontSize="24"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding StreakText}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="✓" FontSize="20" Padding="0"
                                    WidthRequest="46" HeightRequest="46" CornerRadius="23"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                    Command="{Binding ToggleCommand, Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsDoneToday}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{Binding AccentColor}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
