<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HabitTracker.Views"
       x:Class="HabitTracker.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource CardDark}}"
       Shell.TitleColor="White"
       Shell.ForegroundColor="White">

    <ShellContent Title="Привычки"
                  Route="habits"
                  ContentTemplate="{DataTemplate views:HabitsPage}" />
</Shell>
